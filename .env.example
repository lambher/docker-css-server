# Counter-Strike: Source Server Configuration
# Copy this file to .env and customize the values
# IMPORTANT: Never commit .env to version control!

# RCON password for remote administration (required)
# Used by admins to control the server remotely
RCON_PASSWORD=your_secure_rcon_password_here

# Server display name shown in server browser
SERVER_HOSTNAME="My CSS Server"

# Server password (optional)
# Leave empty for a public server, or set a password for private games
SV_PASSWORD=
